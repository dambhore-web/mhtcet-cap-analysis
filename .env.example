# Copy to .env and fill in. Never commit .env.
# Supabase -> project -> Connect -> connection string (session pooler, port 5432)
DATABASE_URL_STAGING=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Only needed when a production load has been approved
DATABASE_URL_PRODUCTION=

# Railway: set DATABASE_URL (without the _STAGING suffix) in the Railway service env panel.
# The API uses process.env.DATABASE_URL at runtime; no .env file is needed in production.
DATABASE_URL=

# Web app: Vite reads this at BUILD time (not runtime).
# Set VITE_API_URL in the Railway web service env panel before deploying.
VITE_API_URL=http://localhost:3001

# Groq AI assistant (groq.com). Set in Railway API service env panel.
GROQ_API_KEY=

# Google sign-in and account sync (#15). Web app, read by Vite at BUILD time.
# Supabase -> Project Settings -> API: Project URL and the anon / publishable key (public by design;
# row-level security protects the data). Leave empty to run without sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Database TLS verification (#131 O3): Supabase → Project Settings → Database → SSL → download the CA
# certificate. Either a path to the .crt file or the PEM text (\n line breaks are fine in env panels).
# Unset = encrypted but not verified (current behaviour). Used by the API and the pipeline.
DATABASE_CA_CERT=
