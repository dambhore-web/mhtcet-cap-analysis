{
  "name": "mhtcet-cap-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Closing-rank analysis of Maharashtra first-year engineering admissions (MHT-CET CAP rounds), built from the State CET Cell's published cutoff, allotment and merit lists.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/pipeline && tsc --noEmit -p apps/api && npm run typecheck -w @mhtcet/web",
    "dev:api": "npm run dev -w @mhtcet/api",
    "dev:web": "npm run dev -w @mhtcet/web",
    "test": "vitest run",
    "discover": "npm run discover -w @mhtcet/pipeline --",
    "download": "npm run download -w @mhtcet/pipeline --",
    "parse:cutoffs": "npm run parse:cutoffs -w @mhtcet/pipeline --",
    "parse:allotment": "npm run parse:allotment -w @mhtcet/pipeline --",
    "parse:merit": "npm run parse:merit -w @mhtcet/pipeline --",
    "parse:institutes": "npm run parse:institutes -w @mhtcet/pipeline --",
    "validate": "npm run validate -w @mhtcet/pipeline --",
    "migrate": "npm run migrate -w @mhtcet/pipeline --",
    "load": "npm run load -w @mhtcet/pipeline --",
    "db:checksum": "npm run db:checksum -w @mhtcet/pipeline --",
    "eval": "node --env-file=.env --import tsx/esm packages/pipeline/eval/runner.ts",
    "e2e": "npm run e2e -w @mhtcet/web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dambhore-web/mhtcet-cap-analysis.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
