{
  "name": "@mhtcet/pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Offline data pipeline: discover, download, parse, validate, load (run by AG-002).",
  "type": "module",
  "scripts": {
    "discover": "tsx src/cli/discover.ts",
    "download": "tsx src/cli/download.ts",
    "parse:cutoffs": "tsx src/cli/parseCutoffs.ts",
    "parse:allotment": "tsx src/cli/parseAllotment.ts",
    "parse:merit": "tsx src/cli/parseMerit.ts",
    "parse:merit:mh": "tsx src/cli/parseMerit.ts PCMMH",
    "parse:institutes": "tsx src/cli/parseInstitutes.ts",
    "parse:seatmatrix": "tsx src/cli/parseSeatMatrix.ts",
    "validate": "tsx src/cli/validate.ts",
    "migrate": "tsx --env-file=../../.env src/cli/migrate.ts",
    "load": "tsx --env-file-if-exists=../../.env src/cli/load.ts",
    "db:checksum": "tsx --env-file=../../.env src/cli/dbChecksum.ts",
    "db:cleanup-codes": "tsx --env-file-if-exists=../../.env src/cli/cleanupCodes.ts",
    "load:merit": "tsx --env-file-if-exists=../../.env src/cli/loadMerit.ts",
    "load:seatmatrix": "tsx --env-file-if-exists=../../.env src/cli/loadSeatMatrix.ts",
    "data:audit": "tsx --env-file-if-exists=../../.env src/cli/audit.ts"
  },
  "dependencies": {
    "@mhtcet/core": "*",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.0"
  }
}
