# Source PDFs and parsed rows contain candidate names - never commit them
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pdf

# Node
node_modules/
dist/
*.tsbuildinfo

# Python leftovers (Python code removed in TASK-0002, see ADR-001)
__pycache__/
*.pyc

# Local env and secrets
.env
.env.*
!.env.example

# reports/ IS committed: run and load reports hold only codes, counts and cutoff values
# (no names, no application IDs). The validate step scans for EN######## before writing.

# Playwright output
apps/web/playwright-report/
apps/web/test-results/
