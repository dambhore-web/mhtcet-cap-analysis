# Source PDFs and parsed rows contain candidate names - never commit them
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pdf

# Node
node_modules/
dist/
*.tsbuildinfo

# Python leftovers (being removed, see ADR-001)
__pycache__/
*.pyc

# Local env and secrets
.env
.env.*
!.env.example
